*******************************************************************************
* Transient and Plot Commands
* Note: sd() displays a range of nodes as a signed decimal (instead of hex)
*******************************************************************************
.tran 600ns
.plot a[31:0]
.plot b[31:0]
.plot fas[31:0]
.plot sd(fcmp[31:0])
.plot d(op0)
.plot d(op1)
.plot d(op2)
.plot d(n)
.plot d(v)
.plot d(z)


